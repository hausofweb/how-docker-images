{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchManagers": ["dockerfile", "custom.regex"],
      "commitMessagePrefix": "fix(deps):",
      "automerge": false
    },
    {
      "description": "The GitHub CLI version and its per-arch .deb digests must move together, or the build's SHA-256 check fails",
      "matchDepNames": ["cli/cli"],
      "groupName": "GitHub CLI"
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "/^v?0\\./",
      "groupName": null
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Node.js major version",
      "managerFilePatterns": ["/^[^/]+/Dockerfile$/"],
      "matchStrings": ["ARG NODE_MAJOR=(?<currentValue>\\d+)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "pnpm version",
      "managerFilePatterns": ["/^[^/]+/Dockerfile$/"],
      "matchStrings": ["ARG PNPM_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "AWS CLI version",
      "managerFilePatterns": ["/^[^/]+/Dockerfile$/"],
      "matchStrings": ["ARG AWS_CLI_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "aws/aws-cli",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "GitHub CLI version and per-arch .deb SHA-256s, as non-overlapping matches so each update applies independently",
      "managerFilePatterns": ["/^[^/]+/Dockerfile$/"],
      "matchStrings": [
        "ARG GH_CLI_VERSION=(?<currentValue>v[\\d.]+)\\n",
        "# renovate: cli/cli (?<currentValue>v[\\d.]+) amd64\\nARG GH_CLI_SHA256_AMD64=(?<currentDigest>[a-f0-9]{64})",
        "# renovate: cli/cli (?<currentValue>v[\\d.]+) arm64\\nARG GH_CLI_SHA256_ARM64=(?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "cli/cli",
      "datasourceTemplate": "github-release-attachments"
    }
  ]
}
