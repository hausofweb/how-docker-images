{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchManagers": ["dockerfile", "custom.regex"],
      "commitMessagePrefix": "fix(deps):",
      "automerge": false
    },
    {
      "description": "The GitHub CLI version and its per-arch .deb digests must move together, or the build's SHA-256 check fails",
      "matchDepNames": ["cli/cli"],
      "groupName": "GitHub CLI"
    },
    {
      "description": "Automerge patch and digest bumps for base images",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Node.js major version",
      "managerFilePatterns": ["/^[^/]+/Dockerfile$/"],
      "matchStrings": ["ARG NODE_MAJOR=(?<currentValue>\\d+)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "pnpm version",
      "managerFilePatterns": ["/^[^/]+/Dockerfile$/"],
      "matchStrings": ["ARG PNPM_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "AWS CLI version",
      "managerFilePatterns": ["/^[^/]+/Dockerfile$/"],
      "matchStrings": ["ARG AWS_CLI_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "aws/aws-cli",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "GitHub CLI version and amd64 .deb SHA-256",
      "managerFilePatterns": ["/^[^/]+/Dockerfile$/"],
      "matchStrings": [
        "ARG GH_CLI_VERSION=(?<currentValue>v[\\d.]+)\\nARG GH_CLI_SHA256_AMD64=(?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "cli/cli",
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "description": "GitHub CLI version and arm64 .deb SHA-256",
      "managerFilePatterns": ["/^[^/]+/Dockerfile$/"],
      "matchStrings": [
        "ARG GH_CLI_VERSION=(?<currentValue>v[\\d.]+)\\nARG GH_CLI_SHA256_AMD64=[a-f0-9]{64}\\nARG GH_CLI_SHA256_ARM64=(?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "cli/cli",
      "datasourceTemplate": "github-release-attachments"
    }
  ]
}
